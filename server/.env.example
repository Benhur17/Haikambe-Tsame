# Server Configuration
PORT=5000
NODE_ENV=development

# Database - FIREBASE (replaces MongoDB)
# Option 1: Use service account JSON file (RECOMMENDED)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Option 2: Use individual credentials (if you prefer)
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# JWT Secret (keep this if using custom JWT auth instead of Firebase Auth)
JWT_SECRET=your-secret-jwt-key-change-this-in-production

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173
